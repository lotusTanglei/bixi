# Archive the filled manifest with the release evidence. Every image must be a
# registry reference pinned to the digest of the pushed, verified artifact.
commit=REPLACE_WITH_FROZEN_40_HEX_COMMIT
version=1.0.0
mode=compose
BIXI_RELEASE_MYSQL_IMAGE=registry.example/bixi/mysql@sha256:REPLACE_WITH_64_HEX_DIGEST
