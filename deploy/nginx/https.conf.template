map $http_upgrade $bixi_connection_upgrade {
    default upgrade;
    '' close;
}

map $bixi_public_path $bixi_sms_limit_key {
    default "";
    ~^/api/admin/mobile/[^/]+$ $binary_remote_addr;
}

limit_req_zone $bixi_sms_limit_key zone=bixi_sms:10m rate=6r/m;

server {
    listen 8443 ssl;
    server_name _;
    set $bixi_public_path $uri;
    limit_req zone=bixi_sms burst=3 nodelay;
    limit_req_status 429;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 11m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location /api/auth/ {
        client_max_body_size 1m;
        resolver 127.0.0.11 valid=10s;
        set $frontend ${BIXI_FRONTEND_UPSTREAM};
        proxy_pass http://$frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $bixi_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location = /api/admin/file/upload {
        client_max_body_size 100m;
        resolver 127.0.0.11 valid=10s;
        set $frontend ${BIXI_FRONTEND_UPSTREAM};
        proxy_pass http://$frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $bixi_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location ~ ^/api/admin/(user|role|post|dept)/import$ {
        client_max_body_size 100m;
        resolver 127.0.0.11 valid=10s;
        set $frontend ${BIXI_FRONTEND_UPSTREAM};
        proxy_pass http://$frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $bixi_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location / {
        resolver 127.0.0.11 valid=10s;
        set $frontend ${BIXI_FRONTEND_UPSTREAM};
        proxy_pass http://$frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $bixi_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
