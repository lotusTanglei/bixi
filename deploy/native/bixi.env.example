# Copy to /etc/bixi/bixi.env, replace every CHANGE_ME, and chmod 0600.
# This file is also shell-sourceable for the one-time database initializer.
BIXI_DEPLOYMENT_MODE=single
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=bixi
MYSQL_USERNAME=bixi
MYSQL_PASSWORD=CHANGE_ME
MYSQL_JDBC_URL='jdbc:mysql://127.0.0.1:3306/bixi?sslMode=REQUIRED&serverTimezone=Asia/Shanghai&characterEncoding=utf8'
# Required for remote MySQL initialization; path to the trusted CA PEM file.
MYSQL_SSL_CA=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
BIXI_ENCODE_KEY=CHANGE_ME
OAUTH_BROWSER_CLIENT_SECRET=CHANGE_ME
JASYPT_ENCRYPTOR_PASSWORD=CHANGE_ME
GENERATOR_PROJECT_ROOT=/var/lib/bixi/generator-output
AI_ENABLED=false
WORKFLOW_ENABLED=false
WORKFLOW_SCHEMA_UPDATE=false
BIXI_RELIABLE_ENABLED=false
BIXI_RELIABLE_RABBIT_ENABLED=false
MINIO_ENABLED=false

# Cloud only. These Nacos credentials belong to a restricted runtime user.
# Keep publisher administrator credentials out of this systemd environment file.
NACOS_HOST=127.0.0.1
NACOS_PORT=8848
NACOS_NAMESPACE=bixi-prod
NACOS_USERNAME=bixi-prod-client
NACOS_PASSWORD=CHANGE_ME
SPRING_CLOUD_NACOS_DISCOVERY_IP=127.0.0.1
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VIRTUAL_HOST=/
BIXI_SBA_CLIENT_URL=http://127.0.0.1:5001
BIXI_SBA_CLIENT_USERNAME=monitor
BIXI_SBA_CLIENT_PASSWORD=CHANGE_ME
BIXI_GATEWAY_SECURITY_INTROSPECTION_URI=http://127.0.0.1:3000/token/check_token

# Optional enabled capabilities.
DASHSCOPE_API_KEY=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
