# Bixi local runtime template. `make init-env` creates `.env` and replaces every
# GENERATE_ON_FIRST_RUN value with a random secret. Never commit `.env`.

COMPOSE_PROJECT_NAME=bixi
TIME_ZONE=Asia/Shanghai

# Optional workflow. Schema creation is only for disposable development databases.
WORKFLOW_ENABLED=false
WORKFLOW_SCHEMA_UPDATE=false
WORKFLOW_ASYNC_EXECUTOR_ACTIVATE=true
# Cloud only: load compose.workflow-cluster.yaml and run two Workflow owners.
WORKFLOW_CLUSTER_ENABLED=false
# Short values below are for a disposable recovery rehearsal, not production.
WORKFLOW_ASYNC_JOB_LOCK_TIME=PT30S
WORKFLOW_TIMER_LOCK_TIME=PT30S
WORKFLOW_RESET_EXPIRED_JOBS_INTERVAL=PT5S
WORKFLOW_DEFAULT_ASYNC_JOB_ACQUIRE_WAIT_TIME=PT1S
WORKFLOW_DEFAULT_TIMER_JOB_ACQUIRE_WAIT_TIME=PT1S
WORKFLOW_MAX_ASYNC_JOBS_DUE_PER_ACQUISITION=4
WORKFLOW_MAX_TIMER_JOBS_PER_ACQUISITION=4
WORKFLOW_RESET_EXPIRED_JOBS_PAGE_SIZE=100
WORKFLOW_RESET_EXPIRED_JOB_ENABLED=true
WORKFLOW_UNLOCK_OWNED_JOBS=true
# Controlled migration requires a stopped Workflow fleet and an explicit shell
# confirmation; these remain disabled unless the operator sets them for one run.
WORKFLOW_MAINTENANCE=false
WORKFLOW_MIGRATION_CONFIRM=

# Optional registry prefixes. The start script selects reachable mirrors when
# Docker Hub is unavailable.
BIXI_REGISTRY_MIRROR=
BIXI_THIRD_PARTY_REGISTRY_MIRROR=

# Host ports
BIXI_HTTP_PORT=8080
GATEWAY_PORT=9999
SINGLE_PORT=9998
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
NACOS_PORT=8848

# Database
MYSQL_DATABASE=bixi
MYSQL_USERNAME=bixi
MYSQL_PASSWORD=GENERATE_ON_FIRST_RUN
MYSQL_ROOT_PASSWORD=GENERATE_ON_FIRST_RUN

# Redis and RabbitMQ
REDIS_PASSWORD=GENERATE_ON_FIRST_RUN
REDIS_DATABASE=0
RABBITMQ_USERNAME=bixi
RABBITMQ_PASSWORD=GENERATE_ON_FIRST_RUN

# Nacos local namespace. Nacos ports are bound to loopback by Compose.
NACOS_NAMESPACE=bixi
NACOS_GROUP=DEFAULT_GROUP

# Application and OAuth development secrets
BIXI_ENCODE_KEY=GENERATE_ON_FIRST_RUN
JASYPT_ENCRYPTOR_PASSWORD=GENERATE_ON_FIRST_RUN
OAUTH_PASSWORD_CLIENT_SECRET=GENERATE_ON_FIRST_RUN
OAUTH_MOBILE_CLIENT_SECRET=GENERATE_ON_FIRST_RUN
OAUTH_INTERNAL_SEED=GENERATE_ON_FIRST_RUN
TENANT_DEFAULT_PASSWORD=GENERATE_ON_FIRST_RUN

# Administrative and optional object-storage credentials
DRUID_USERNAME=bixi
DRUID_PASSWORD=GENERATE_ON_FIRST_RUN
MINIO_ENDPOINT=http://127.0.0.1:9800
MINIO_ACCESS_KEY=GENERATE_ON_FIRST_RUN
MINIO_SECRET_KEY=GENERATE_ON_FIRST_RUN

# The generated administrator password is stored only in `.env`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE_ON_FIRST_RUN
ADMIN_PASSWORD_BCRYPT_B64=GENERATE_ON_FIRST_RUN

# Optional JVM tuning
GATEWAY_JAVA_OPTS='-Xms192m -Xmx384m'
AUTH_JAVA_OPTS='-Xms192m -Xmx384m'
UPMS_JAVA_OPTS='-Xms256m -Xmx512m'
SINGLE_JAVA_OPTS='-Xms384m -Xmx768m'
