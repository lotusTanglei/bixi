# Bixi local runtime template. `make init-env` creates `.env` and replaces every
# GENERATE_ON_FIRST_RUN value with a random secret. Never commit `.env`.

COMPOSE_PROJECT_NAME=bixi
TIME_ZONE=Asia/Shanghai

# Optional workflow. Schema creation is only for disposable development databases.
WORKFLOW_ENABLED=false
WORKFLOW_SCHEMA_UPDATE=false
WORKFLOW_ASYNC_EXECUTOR_ACTIVATE=true
# Required whenever Workflow is enabled. Cloud also requires the Rabbit adapter;
# single uses the local durable adapter and may keep the Rabbit adapter disabled.
BIXI_RELIABLE_ENABLED=false
BIXI_RELIABLE_RABBIT_ENABLED=false
# Cloud only: load compose.workflow-cluster.yaml and run two Workflow owners.
WORKFLOW_CLUSTER_ENABLED=false
# Short values below are for a disposable recovery rehearsal, not production.
WORKFLOW_ASYNC_JOB_LOCK_TIME=PT30S
WORKFLOW_TIMER_LOCK_TIME=PT30S
WORKFLOW_RESET_EXPIRED_JOBS_INTERVAL=PT5S
WORKFLOW_DEFAULT_ASYNC_JOB_ACQUIRE_WAIT_TIME=PT1S
WORKFLOW_DEFAULT_TIMER_JOB_ACQUIRE_WAIT_TIME=PT1S
WORKFLOW_MAX_ASYNC_JOBS_DUE_PER_ACQUISITION=4
WORKFLOW_MAX_TIMER_JOBS_PER_ACQUISITION=4
WORKFLOW_RESET_EXPIRED_JOBS_PAGE_SIZE=100
WORKFLOW_RESET_EXPIRED_JOB_ENABLED=true
WORKFLOW_UNLOCK_OWNED_JOBS=true
# Controlled migration requires a stopped Workflow fleet and an explicit shell
# confirmation; these remain disabled unless the operator sets them for one run.
WORKFLOW_MAINTENANCE=false
WORKFLOW_MIGRATION_CONFIRM=

# Optional registry prefixes. The start script selects reachable mirrors when
# Docker Hub is unavailable.
BIXI_REGISTRY_MIRROR=
BIXI_THIRD_PARTY_REGISTRY_MIRROR=

# Host ports
BIXI_HTTP_PORT=8080
GATEWAY_PORT=9999
SINGLE_PORT=9998
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
NACOS_PORT=8848
MONITOR_PORT=5001

# Spring Boot Admin. Cloud starts the monitor and registers backend instances;
# the single profile overrides the client to disabled and exposes health only.
BIXI_SBA_CLIENT_ENABLED=true
BIXI_SBA_CLIENT_URL=http://monitor:5001
BIXI_SBA_CLIENT_USERNAME=monitor
BIXI_SBA_CLIENT_PASSWORD=GENERATE_ON_FIRST_RUN
BIXI_MANAGEMENT_ENDPOINTS=health,info,metrics,loggers,logfile,dynamictp

# Cloud Gateway token validation. Leave blank for Compose's internal `auth`
# service default; direct local runs fall back to 127.0.0.1:3000.
BIXI_GATEWAY_SECURITY_INTROSPECTION_URI=
BIXI_GATEWAY_SECURITY_REQUEST_TIMEOUT=3s

# Generator output mount source. Keep the named volume default, or set a host
# directory that is writable by container UID 10001 to inspect generated files.
GENERATOR_OUTPUT_PATH=generator-output

# AI is opt-in in cloud and single deployments. Keep the provider key out of
# source control; start-cloud rejects AI_ENABLED=true when this value is empty.
AI_ENABLED=false
DASHSCOPE_API_KEY=
AI_CHAT_ENABLED=true
AI_EMBEDDING_ENABLED=true
AI_PORT=5000

# Notice channel adapters. Notices default to in-app SSE. Email and Webhook
# use configured HTTP providers; SMS and WeChat remain fail-closed until a
# verified provider adapter is installed.
NOTICE_DEFAULT_CHANNEL=IN_APP
NOTICE_RECEIPT_ENABLED=false
NOTICE_RECEIPT_SECRET=
NOTICE_RECEIPT_SIGNATURE_HEADER=X-Bixi-Notice-Signature
NOTICE_WEBHOOK_ENABLED=false
NOTICE_WEBHOOK_ENDPOINT=
NOTICE_WEBHOOK_BEARER_TOKEN=
NOTICE_EMAIL_ENABLED=false
NOTICE_EMAIL_ENDPOINT=
NOTICE_EMAIL_API_KEY=
NOTICE_EMAIL_FROM=
NOTICE_SMS_ENABLED=false
NOTICE_SMS_ENDPOINT=
NOTICE_WECHAT_ENABLED=false
NOTICE_WECHAT_ENDPOINT=

# Database
MYSQL_DATABASE=bixi
MYSQL_USERNAME=bixi
MYSQL_PASSWORD=GENERATE_ON_FIRST_RUN
MYSQL_ROOT_PASSWORD=GENERATE_ON_FIRST_RUN

# Redis and RabbitMQ
REDIS_PASSWORD=GENERATE_ON_FIRST_RUN
REDIS_DATABASE=0
# Broker bootstrap credentials are used only by RabbitMQ and the one-shot
# access provisioner. Application containers receive the isolated users below.
RABBITMQ_USERNAME=bixi
RABBITMQ_PASSWORD=GENERATE_ON_FIRST_RUN
RABBITMQ_APP_USERNAME=bixi-app
RABBITMQ_APP_PASSWORD=GENERATE_ON_FIRST_RUN
RABBITMQ_UPMS_USERNAME=bixi-upms
RABBITMQ_UPMS_PASSWORD=GENERATE_ON_FIRST_RUN
RABBITMQ_WORKFLOW_USERNAME=bixi-workflow
RABBITMQ_WORKFLOW_PASSWORD=GENERATE_ON_FIRST_RUN
RABBITMQ_WORKFLOW_VHOST=/bixi-workflow

# Nacos local namespace. Nacos ports are bound to loopback by Compose.
NACOS_NAMESPACE=bixi
NACOS_GROUP=DEFAULT_GROUP

# Application and OAuth development secrets
BIXI_ENCODE_KEY=GENERATE_ON_FIRST_RUN
JASYPT_ENCRYPTOR_PASSWORD=GENERATE_ON_FIRST_RUN
OAUTH_PASSWORD_CLIENT_SECRET=GENERATE_ON_FIRST_RUN
OAUTH_MOBILE_CLIENT_SECRET=GENERATE_ON_FIRST_RUN
OAUTH_INTERNAL_SEED=GENERATE_ON_FIRST_RUN
TENANT_DEFAULT_PASSWORD=GENERATE_ON_FIRST_RUN

# Administrative and optional object-storage credentials
DRUID_USERNAME=bixi
DRUID_PASSWORD=GENERATE_ON_FIRST_RUN
MINIO_ENDPOINT=http://127.0.0.1:9800
MINIO_ACCESS_KEY=GENERATE_ON_FIRST_RUN
MINIO_SECRET_KEY=GENERATE_ON_FIRST_RUN

# The generated administrator password is stored only in `.env`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE_ON_FIRST_RUN
ADMIN_PASSWORD_BCRYPT_B64=GENERATE_ON_FIRST_RUN

# Optional JVM tuning
GATEWAY_JAVA_OPTS='-Xms192m -Xmx384m'
AUTH_JAVA_OPTS='-Xms192m -Xmx384m'
UPMS_JAVA_OPTS='-Xms256m -Xmx512m'
GENERATOR_JAVA_OPTS='-Xms192m -Xmx384m'
QUARTZ_JAVA_OPTS='-Xms192m -Xmx384m'
AI_JAVA_OPTS='-Xms256m -Xmx512m'
SINGLE_JAVA_OPTS='-Xms384m -Xmx768m'
