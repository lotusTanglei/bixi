# Bixi 项目环境变量配置示例
# 使用方法：
# 1. 复制本文件为 .env（不提交到 Git）
# 2. 填写真实的配置值
# 3. 在 application.yml 中通过 ${KEY} 引用

# ====================
# 数据库配置
# ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=bixi
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password-here

# ====================
# Redis 配置
# ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here
REDIS_DATABASE=0

# ====================
# Nacos 配置
# ====================
NACOS_HOST=127.0.0.1
NACOS_PORT=8848
NACOS_NAMESPACE=dev
NACOS_GROUP=DEFAULT_GROUP

# ====================
# JWT 安全配置
# ====================
# ⚠️ 生产环境请使用强密钥（至少 256 位）
# 生成方法: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-key-here-change-it
JWT_EXPIRATION=7200

# ====================
# 对象存储配置 (MinIO)
# ====================
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=your-minio-access-key-here
MINIO_SECRET_KEY=your-minio-secret-key-here
MINIO_BUCKET_NAME=bixi

# ====================
# AI 服务配置 (可选)
# ====================
AI_API_KEY=your-ai-api-key-here
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo

# ====================
# 工作流配置
# ====================
FLOWABLE_ADMIN_HOST=http://127.0.0.1
FLOWABLE_ADMIN_PORT=8081

# ====================
# 应用配置
# ====================
# 应用端口
SERVER_PORT=8080

# 应用环境 (dev/test/prod)
SPRING_PROFILES_ACTIVE=dev

# 日志级别
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_LOTUS_BIXI=DEBUG

# ====================
# 监控配置 (可选)
# ====================
# Spring Boot Admin
ADMIN_SERVER_URL=http://localhost:8888

# Prometheus 端点
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# ====================
# 邮件配置 (可选)
# ====================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password-here
MAIL_FROM=noreply@bixi.com

# ====================
# 第三方服务配置 (可选)
# ====================
# 短信服务
SMS_ACCESS_KEY=your-sms-access-key
SMS_SECRET_KEY=your-sms-secret-key

# OSS 服务 (阿里云/AWS)
OSS_ENDPOINT=your-oss-endpoint
OSS_ACCESS_KEY=your-oss-access-key
OSS_SECRET_KEY=your-oss-secret-key
OSS_BUCKET_NAME=bixi

# ====================
# Sentinel 配置
# ====================
SENTINEL_ENABLED=true
SENTINEL_DASHBOARD_HOST=localhost
SENTINEL_DASHBOARD_PORT=8080

# ====================
# 其他配置
# ====================
# 时区
TIME_ZONE=Asia/Shanghai

# 文件上传限制
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=100MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=100MB

# ====================
# 注意事项
# ====================
# 1. 请勿将 .env 文件提交到 Git 仓库
# 2. 生产环境请使用强密码
# 3. 定期轮换密钥和密码
# 4. 不同环境使用不同的配置值
