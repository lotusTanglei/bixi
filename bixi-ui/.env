# 是否是微服务架构（重要）
VITE_IS_MICRO= true

# 前端访问前缀
VITE_PUBLIC_PATH = /

# 后端请求前缀
VITE_API_URL = /api

# 是否开启前端验证码
VITE_VERIFY_ENABLE = true

# 验证码类型
VITE_CAPTCHA_TYPE = 'arithmetic'

# 是否开启websocket 消息接受,
VITE_WEBSOCKET_ENABLE = false

# 是否开启SSE 消息接受
VITE_SSE_ENABLE = true

# 是否开启注册
VITE_REGISTER_ENABLE  = true
