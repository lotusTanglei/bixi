# port 端口号
VITE_PORT = 8888

#浏览器自动打开
VITE_OPEN = true

# 本地环境
ENV = 'development'

# API 接口地址
VITE_API_URL = /api

# ADMIN 服务地址
VITE_ADMIN_PROXY_PATH = http://127.0.0.1:9999

# 代码生成服务地址 (单体架构有效)
VITE_GEN_PROXY_PATH = http://127.0.0.1:5003

# 单体开发环境
VITE_IS_MICRO = false
VITE_OAUTH2_PASSWORD_CLIENT = 'bixi:bixi'
VITE_VERIFY_ENABLE = false
VITE_CAPTCHA_TYPE = 'arithmetic'
# 后端兼容明文密码；避免继承微服务环境中的旧版 CFB 加密配置
VITE_PWD_ENC_KEY =
