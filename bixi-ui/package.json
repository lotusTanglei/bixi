{
  "name": "bixi-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --force",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 BROWSERSLIST_IGNORE_OLD_DATA=1 vite build",
    "build:dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 BROWSERSLIST_IGNORE_OLD_DATA=1 vite build --mode development",
    "build:test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 BROWSERSLIST_IGNORE_OLD_DATA=1 vite build --mode test",
    "build:prod": "cross-env NODE_OPTIONS=--max-old-space-size=4096 BROWSERSLIST_IGNORE_OLD_DATA=1 vite build --mode production",
    "build:docker": "cross-env NODE_OPTIONS=--max-old-space-size=4096 BROWSERSLIST_IGNORE_OLD_DATA=1 vite build --outDir ./docker/dist/",
    "lint:eslint": "eslint ./src --fix",
    "prettier": "prettier --write ."
  },
  "type": "module",
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "@vueuse/core": "^14.2.1",
    "@wangeditor/editor": "5.1.23",
    "@wangeditor/editor-for-vue": "5.1.12",
    "autoprefixer": "10.4.20",
    "axios": "1.7.7",
    "china-area-data": "^5.0.1",
    "codemirror": "5.65.18",
    "crypto-js": "4.2.0",
    "dompurify": "^3.3.3",
    "echarts": "5.5.1",
    "element-plus": "2.8.6",
    "js-cookie": "3.0.5",
    "mitt": "3.0.1",
    "nprogress": "0.2.0",
    "pinia": "2.2.6",
    "postcss": "8.4.47",
    "qs": "6.13.0",
    "screenfull": "6.0.2",
    "sm-crypto": "0.3.13",
    "sortablejs": "1.15.3",
    "splitpanes": "3.1.5",
    "tailwindcss": "3.4.14",
    "vue": "3.5.12",
    "vue-clipboard3": "2.0.0",
    "vue-i18n": "9.14.1",
    "vue-router": "4.4.5"
  },
  "devDependencies": {
    "@swc/core": "1.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/node": "20.0.0",
    "@types/nprogress": "0.2.0",
    "@types/sortablejs": "1.15.0",
    "@typescript-eslint/eslint-plugin": "8.13.0",
    "@typescript-eslint/parser": "8.13.0",
    "@vitejs/plugin-vue": "5.0.5",
    "@vue/compiler-sfc": "3.4.3",
    "consola": "3.0.0",
    "cross-env": "7.0.3",
    "eslint": "9.14.0",
    "eslint-plugin-vue": "9.30.0",
    "glob": "9.3.5",
    "pinia-plugin-persist": "1.0.0",
    "prettier": "3.3.3",
    "sass": "1.58.3",
    "terser": "5.31.1",
    "typescript": "5.6.3",
    "unplugin-auto-import": "0.18.0",
    "unplugin-vue-setup-extend-plus": "1.0.1",
    "vite": "5.3.3",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-top-level-await": "1.4.1",
    "vue-eslint-parser": "9.4.3"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">= 8.0.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "vuejs/vue-next",
    "element-ui",
    "element-plus"
  ],
  "resolutions": {
    "@swc/core": "~1.6.13"
  }
