<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="https://bixi.example/workflow">
    <process id="demo_leave_approval" name="请假申请审批 v2" isExecutable="true">
        <documentation>审批完成后通过 durable service task 请求 UPMS 登记；结果由 receive task 恢复，超时或失败进入补偿。</documentation>
        <startEvent id="start" name="提交申请"/>
        <sequenceFlow id="toReview" sourceRef="start" targetRef="review"/>
        <userTask id="review" name="请假审批" flowable:assignee="${approverId}">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskCreateListener}"/>
            </extensionElements>
        </userTask>
        <sequenceFlow id="toRequest" sourceRef="review" targetRef="requestBusiness"/>
        <serviceTask id="requestBusiness" name="请求请假登记"
                     flowable:delegateExpression="${leaveBusinessTaskRequestDelegate}"/>
        <sequenceFlow id="toBusinessWait" sourceRef="requestBusiness" targetRef="waitBusinessResult"/>
        <receiveTask id="waitBusinessResult" name="等待请假登记结果"/>
        <boundaryEvent id="businessTimeout" name="登记超时" attachedToRef="waitBusinessResult" cancelActivity="true">
            <timerEventDefinition><timeDuration>PT5M</timeDuration></timerEventDefinition>
        </boundaryEvent>
        <sequenceFlow id="timeoutToCompensate" sourceRef="businessTimeout" targetRef="requestCompensation"/>
        <sequenceFlow id="toBusinessGateway" sourceRef="waitBusinessResult" targetRef="businessGateway"/>
        <exclusiveGateway id="businessGateway" name="登记是否成功"/>
        <sequenceFlow id="businessSuccess" sourceRef="businessGateway" targetRef="endApproved">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${businessTaskSuccess == true}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="businessFailure" sourceRef="businessGateway" targetRef="requestCompensation">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${businessTaskSuccess != true}]]></conditionExpression>
        </sequenceFlow>
        <serviceTask id="requestCompensation" name="请求请假补偿"
                     flowable:delegateExpression="${leaveCompensationRequestDelegate}"/>
        <sequenceFlow id="toCompensationWait" sourceRef="requestCompensation" targetRef="waitCompensationResult"/>
        <receiveTask id="waitCompensationResult" name="等待请假补偿结果"/>
        <sequenceFlow id="toCanceled" sourceRef="waitCompensationResult" targetRef="endCanceled"/>
        <endEvent id="endApproved" name="登记完成"/>
        <endEvent id="endCanceled" name="登记补偿">
            <terminateEventDefinition/>
        </endEvent>
    </process>
</definitions>
