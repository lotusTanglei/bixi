<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>bixi-module</artifactId>
        <groupId>com.lotus</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>bixi-workflow-biz</artifactId>
    <packaging>jar</packaging>
    <description>bixi 工作流服务业务处理模块</description>

    <dependencies>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Cross-owner integration coverage only; production workflow code stays UPMS-agnostic. -->
        <dependency>
            <groupId>com.lotus</groupId>
            <artifactId>bixi-upms-biz</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lotus</groupId>
            <artifactId>bixi-workflow-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lotus</groupId>
            <artifactId>bixi-upms-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lotus</groupId>
            <artifactId>bixi-common-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lotus</groupId>
            <artifactId>bixi-common-mq</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lotus</groupId>
            <artifactId>bixi-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lotus</groupId>
            <artifactId>bixi-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lotus</groupId>
            <artifactId>bixi-common-swagger</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lotus</groupId>
            <artifactId>bixi-common-datasource</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-undertow</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>cloud</id>
            <properties><workflow.test.mode>cloud</workflow.test.mode></properties>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>single</id>
            <properties><workflow.test.mode>single</workflow.test.mode></properties>
        </profile>
    </profiles>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <filtering>true</filtering>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../../bixi-project-documents/sql</directory>
                <targetPath>sql</targetPath>
                <includes><include>01_init_all_tables.sql</include></includes>
            </testResource>
        </testResources>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
