import io.swagger.v3.oas.annotations.media.Schema;
#if($hasRequiredImportFields)
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.NotNull;
#end
import jakarta.validation.constraints.Size;
import lombok.Data;
#foreach($import in $importList)
import ${import};
#end

@Data
@Schema(description = "导入${tableComment}")
public class ${ClassName}ImportDTO {

#foreach($field in $importFieldList)
#if($field.formRequired == '1')
#if($field.attrType == 'String')
	@NotBlank(message = "$!field.fieldComment不能为空")
