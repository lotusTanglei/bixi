#end
#end
#if($field.attrType == 'String')
	@Size(max = 512, message = "$!field.fieldComment长度不能超过512")
#end
	@ExcelProperty("$!field.fieldComment")
	@Schema(description = "$!field.fieldComment")
	private ${field.attrType} ${field.attrName};

