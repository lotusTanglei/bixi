<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lotus.bixi.upms.mapper.SysUserNoticeMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lotus.bixi.upms.api.entity.SysUserNotice">
        <id column="id" property="id" />
        <result column="notice_id" property="noticeId" />
        <result column="user_id" property="userId" />
        <result column="is_read" property="isRead" />
        <result column="read_time" property="readTime" />
        <result column="tenant_id" property="tenantId" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="del_flag" property="delFlag" />
        <result column="remark" property="remark" />
    </resultMap>

    <resultMap id="UserNoticeVOMap" type="com.lotus.bixi.upms.api.vo.UserNoticeVO" extends="BaseResultMap">
        <result column="title" property="title" />
        <result column="content" property="content" />
        <result column="type" property="type" />
        <result column="priority" property="priority" />
        <result column="sender_name" property="senderName" />
        <result column="sender_avatar" property="senderAvatar" />
        <result column="recipient_name" property="recipientName" />
    </resultMap>

    <select id="selectUserNoticePage" resultMap="UserNoticeVOMap">
        SELECT
            un.*,
            n.title,
            n.content,
            n.type,
            n.priority,
            u.nickname AS sender_name,
            u.avatar AS sender_avatar,
            COALESCE(r.nickname, r.name, r.username) AS recipient_name
        FROM
            sys_user_notice un
            LEFT JOIN sys_notice n ON un.notice_id = n.id
            LEFT JOIN sys_user u ON n.sender_id = u.id
            LEFT JOIN sys_user r ON un.user_id = r.id
        <where>
            un.del_flag = '0'
            <if test="query.userId != null">
                AND un.user_id = #{query.userId}
            </if>
            <if test="query.noticeId != null">
                AND un.notice_id = #{query.noticeId}
            </if>
            <if test="query.isRead != null and query.isRead != ''">
                AND un.is_read = #{query.isRead}
            </if>
            <if test="query.tenantId != null">
                AND un.tenant_id = #{query.tenantId}
            </if>
            <if test="query.recipientName != null and query.recipientName != ''">
                AND r.nickname LIKE concat('%', #{query.recipientName}, '%')
            </if>
        </where>
        ORDER BY un.create_time DESC
    </select>

    <select id="selectUserNoticeById" resultMap="UserNoticeVOMap">
        SELECT
            un.*,
            n.title,
            n.content,
            n.type,
            n.priority,
            u.nickname AS sender_name,
            u.avatar AS sender_avatar
        FROM
            sys_user_notice un
            LEFT JOIN sys_notice n ON un.notice_id = n.id
            LEFT JOIN sys_user u ON n.sender_id = u.id
        WHERE
            un.id = #{id}
    </select>

</mapper>
