<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lotus.bixi.upms.mapper.SysRoleMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lotus.bixi.upms.api.entity.SysRole">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="del_flag" property="delFlag"/>
    </resultMap>

    <!-- 通过用户ID，查询角色信息-->
    <select id="listRolesByUserId" resultMap="BaseResultMap">
        SELECT sys_role.id,
               sys_role.name,
               sys_role.code,
               sys_role.description,
               sys_role.create_time,
               sys_role.update_time,
               sys_role.del_flag
        FROM sys_role,
             sys_user_role
        WHERE sys_role.id = sys_user_role.role_id
          AND sys_role.del_flag = '0'
          and sys_user_role.user_id = #{userId}
    </select>
</mapper>
